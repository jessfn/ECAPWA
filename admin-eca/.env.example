# admin-eca — variables de entorno de ejemplo
#
# Copia este archivo a `.env` (o `.env.local`). No subas el `.env` real.
# No pongas secretos aquí: es la URL pública del backend, no una credencial.

# URL base del backend ECA (ECA-005: ya se lee de verdad, vía Axios).
VITE_API_URL=http://localhost:8000
# VITE_API_URL=https://api-eca.example.com  # producción

# Token público (pk.…) de Mapbox para el mapa de la vista Geografía — el
# mismo que usa admin-pwa en su Visor de Seguimiento. Es una clave pública
# de solo lectura (restringible por dominio en el panel de Mapbox), no un
# secreto de servidor.
VITE_MAPBOX_TOKEN=pk.tu_token_publico_de_mapbox
