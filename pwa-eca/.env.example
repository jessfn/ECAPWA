# pwa-eca — variables de entorno de ejemplo
#
# Copia este archivo a `.env` (o `.env.local`). No subas el `.env` real.
# No pongas secretos aquí (una PWA no debe tener secretos de servidor).

# URL base del backend ECA (ECA-011).
VITE_API_URL=http://localhost:8000
# VITE_API_URL=https://api-eca.example.com  # producción

# DP-1: validez en días de la sesión local offline. Debe coincidir con
# `OFFLINE_SESSION_DIAS` del backend (backend-eca/.env) — no hay endpoint que
# la exponga todavía, así que se mantiene sincronizada manualmente entre los
# dos `.env`. Si no se define, la PWA usa 30 por defecto (mismo default que
# el backend).
VITE_OFFLINE_SESSION_DIAS=30
