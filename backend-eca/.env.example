# backend-eca — variables de entorno de ejemplo
#
# Copia este archivo a `.env` y complétalo con valores reales.
# NUNCA subas el `.env` real al repositorio (está en .gitignore).
# No pongas secretos reales en este archivo de ejemplo.

# --- Entorno ---
APP_ENV=development
APP_NAME=backend-eca

# --- Base de datos (ECA-002) ---
DATABASE_URL=postgresql+psycopg://usuario:CAMBIA_ESTO@localhost:5432/eca_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Seguridad (cableado en ECA-003; declarado desde ECA-002 para que la
# app no arranque sin él) ---
SECRET_KEY=                 # cadena larga y aleatoria; SIN valor por defecto (la app no arranca sin ella)
ACCESS_TOKEN_MIN=15
REFRESH_TOKEN_DIAS=30       # DP-1 (06 §2.2): configurable
OFFLINE_SESSION_DIAS=30     # DP-1 (06 §2.2): validez de la sesión local offline

# --- CORS (ECA-002) ---
CORS_ORIGINS=https://eca.example.com,https://admin-eca.example.com

# --- Almacenamiento de evidencias (declarado desde ECA-002; se usa desde ECA-015+) ---
STORAGE_DIR=./storage
